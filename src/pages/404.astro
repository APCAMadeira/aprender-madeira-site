---
import Base from '../layouts/Base.astro';
import Lupa from '../components/Lupa.astro';
import { textos } from '../lib/textos';
const t = textos('pt');
---
<Base lingua="pt" titulo={t.paginaNaoEncontrada} alternativas={{}} pesquisaNoTopo={false}>
  <div class="contentor seccao" style="padding-top: 56px; max-width: 900px">
    <h1 style="margin: 0 0 12px; font-size: clamp(36px, 5vw, 52px)">{t.paginaNaoEncontrada}</h1>
    <p>{t.paginaNaoEncontradaTexto}</p>
    <form role="search" action="/pesquisa/" method="get" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px">
      <label for="q404" class="so-leitores">{t.pesquisaTitulo}</label>
      <input id="q404" name="q" type="search" placeholder={t.exemploPesquisa}
        style="flex: 1 1 280px; min-width: 0; height: 56px; padding: 0 18px; border: 2px solid var(--tinta); border-radius: var(--raio); font: inherit" />
      <button type="submit" class="botao-lima"><Lupa />{t.pesquisar}</button>
    </form>
  </div>
</Base>
