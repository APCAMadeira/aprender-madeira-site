# Copiar para .env no servidor e preencher. Nunca enviar o .env para o GitHub.
SITE_URL=https://teste.aprenderamadeira.net
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_TOKEN=
ASSETS_URL=https://cms.aprenderamadeira.net
# 1 no servidor: as imagens são copiadas do Directus para o site (npm run imagens)
IMAGENS_LOCAIS=1
# Pasta onde ficam as imagens copiadas (no servidor, fora do repositório)
IMAGENS_DIR=/persistente/imagens
# Ficheiro das citações (no servidor, fora do repositório)
CITACOES_FICHEIRO=/persistente/citacoes.json
# Pesquisa (chave só de pesquisa do Meilisearch; pode ser pública)
PUBLIC_MEILI_URL=
PUBLIC_MEILI_CHAVE=
# 1 no site de teste: pede aos motores de busca que não indexem
NAO_INDEXAR=1
